<form id="login-form" class="card form auth">
  <h1 class="form-title">Welcome back</h1>
  <p class="muted">Log in to write posts and join the discussion.</p>

  <label class="form-label" for="username-login">Username</label>
  <input id="username-login" type="text" autocomplete="username" autofocus class="form-input" required />

  <label class="form-label" for="password-login">Password</label>
  <input id="password-login" type="password" autocomplete="current-password" class="form-input" required />

  <p class="form-error" id="form-error" role="alert"></p>
  <button type="submit" class="btn btn-block">Log in</button>
  <p class="muted center">New here? <a href="/signup">Create an account</a></p>
</form>

<script src="/javascript/login.js"></script>
