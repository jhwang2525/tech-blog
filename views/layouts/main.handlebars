<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>The Tech Blog</title>
    <meta name="description" content="A CMS-style blog where developers publish posts and discuss each other's work." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>

  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/"><span class="brand-mark">&lt;/&gt;</span> The Tech Blog</a>
        <nav class="nav" aria-label="Main">
          <a class="nav-link" href="/">Home</a>
          <a class="nav-link" href="/dashboard">Dashboard</a>
          {{#if loggedIn}}
            <button type="button" class="btn btn-ghost btn-sm" id="logout">Log out</button>
          {{else}}
            <a class="btn btn-sm" href="/login">Log in</a>
          {{/if}}
        </nav>
      </div>
    </header>

    <main class="container main">
      {{{ body }}}
    </main>

    <footer class="site-footer">
      <div class="container">Built with Node.js, Express, Handlebars and Sequelize.</div>
    </footer>

    {{#if loggedIn}}
      <script src="/javascript/logout.js"></script>
    {{/if}}
  </body>
</html>
