<a class="back-link" href="/dashboard">← Dashboard</a>

<form class="card form narrow edit-post-form">
  <h1 class="form-title">Edit post</h1>
  <label for="post-title" class="form-label">Title</label>
  <input id="post-title" name="post-title" type="text" value="{{post.title}}" class="form-input" required />

  <label class="form-label" for="content">Content</label>
  <textarea id="content" name="content" class="form-input" rows="10" required>{{post.content}}</textarea>

  <div class="form-actions">
    <button type="submit" class="btn">Save changes</button>
    <button type="button" class="delete-post-btn btn btn-danger">Delete post</button>
  </div>
</form>

<script src="/javascript/edit-post.js"></script>
<script src="/javascript/delete-post.js"></script>
