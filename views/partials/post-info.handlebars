<article class="card post-card">
  <div class="post-meta">
    <span class="avatar" aria-hidden="true">{{initial user.username}}</span>
    <span><strong>{{user.username}}</strong> · {{format_date created_at}}</span>
  </div>
  <h2 class="post-title"><a href="/post/{{id}}">{{title}}</a></h2>
  <p class="post-excerpt">{{content}}</p>
  <a class="post-footer" href="/post/{{id}}">
    <span>{{comments.length}} {{pluralize comments.length "comment"}}</span>
    <span class="read-more">Read post →</span>
  </a>
</article>
