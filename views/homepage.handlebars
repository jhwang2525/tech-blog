<section class="page-hero">
  <p class="eyebrow">Latest posts</p>
  <h1>Notes on building for the web</h1>
  <p class="lead">Developers sharing what they're learning, from front-end tricks to back-end architecture.</p>
</section>

{{#if posts.length}}
  <div class="post-grid">
    {{#each posts as |post|}}
      {{> post-info post}}
    {{/each}}
  </div>
{{else}}
  <div class="empty">
    <p>No posts yet.</p>
    <a class="btn" href="/dashboard/new">Write the first one</a>
  </div>
{{/if}}
