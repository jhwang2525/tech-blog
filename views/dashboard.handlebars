<section class="page-hero row">
  <div>
    <p class="eyebrow">Dashboard</p>
    <h1>Your posts</h1>
  </div>
  <a class="btn" href="/dashboard/new">+ New post</a>
</section>

{{#if posts.length}}
  <div class="dash-list">
    {{#each posts as |post|}}
      {{> dashboard-postinfo post}}
    {{/each}}
  </div>
{{else}}
  <div class="empty">
    <p>You haven't written anything yet.</p>
    <a class="btn" href="/dashboard/new">Write your first post</a>
  </div>
{{/if}}
